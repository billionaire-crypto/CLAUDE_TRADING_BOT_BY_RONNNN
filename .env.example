# ============================================================
# TRADING BOT V29 - TopstepX Runtime Environment
# ============================================================
# 1. Copy this file to .env
# 2. Fill in your real values
# 3. Keep .env out of git
# ============================================================

# TopstepX / ProjectX credentials
TOPSTEPX_USERNAME=your_topstepx_username
TOPSTEPX_API_KEY=your_projectx_api_key
TOPSTEPX_ACCOUNT_NAME=your_topstepx_account_name

# Account metadata used by the runtime guardrails
TOPSTEP_ACCOUNT_SIZE_USD=50000
# combine | xfa | xfa_consistency
TOPSTEP_ACCOUNT_STAGE=combine

# Contract and routing controls
TOPSTEPX_CONTRACT=MNQ
TOPSTEPX_LIVE_DATA=false
TOPSTEPX_DRY_RUN=true
TOPSTEPX_ENABLE_ORDER_ROUTING=false
TOPSTEPX_ENABLE_USER_HUB=true

# Optional API host override
# TOPSTEPX_API_BASE_URL=https://api.thefuturesdesk.projectx.com

# Optional logging override
LOG_LEVEL=INFO
